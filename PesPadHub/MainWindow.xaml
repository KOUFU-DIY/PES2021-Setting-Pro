<Window x:Class="PesPadHub.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource S.AppTitle}"
        Width="680" Height="760" MinWidth="620" MinHeight="600"
        Language="zh-CN" FontFamily="Segoe UI Variable Text, Segoe UI, Microsoft YaHei UI"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <!-- 图标字体只设在图标文字本身上; 设在按钮上会被悬停提示继承, 提示文字就成了方块 -->
        <Style x:Key="Glyph" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="14" />
            <Style.Triggers>
                <!-- 按钮禁用时主题只会调暗它自己生成的文字, 这里的图标要自己跟着变暗 -->
                <DataTrigger Binding="{Binding IsEnabled, RelativeSource={RelativeSource AncestorType=Button}}" Value="False">
                    <Setter Property="Opacity" Value="0.3" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="4,0,0,0" />
        </Style>

        <!-- 总开关: 滑块样式的 CheckBox -->
        <Style x:Key="Switch" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal" Background="Transparent">
                            <Border x:Name="Track" Width="46" Height="24" CornerRadius="12" VerticalAlignment="Center"
                                    Background="{StaticResource SwitchOffBrush}">
                                <Ellipse x:Name="Thumb" Width="16" Height="16" Margin="4,0" Fill="White"
                                         HorizontalAlignment="Left" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Track" Property="Background" Value="{StaticResource GoBrush}" />
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="16,12,16,14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Style="{StaticResource Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="MasterSwitch" Style="{StaticResource Switch}" FontWeight="SemiBold"
                          Content="{DynamicResource S.Master}" AutomationProperties.AutomationId="Master"
                          Checked="Master_Toggled" Unchecked="Master_Toggled"
                          ToolTip="{DynamicResource S.TipMaster}" />
                <TextBlock x:Name="StatusText" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center"
                           HorizontalAlignment="Right" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <CheckBox x:Name="AutoStartCheck" VerticalAlignment="Center" Content="{DynamicResource S.AutoStart}"
                      Checked="AutoStart_Toggled" Unchecked="AutoStart_Toggled" AutomationProperties.AutomationId="AutoStart"
                      ToolTip="{DynamicResource S.TrayNote}" />
            <ComboBox x:Name="LanguageBox" Grid.Column="1" MinWidth="120" VerticalAlignment="Center"
                      SelectionChanged="Language_Changed" ToolTip="{DynamicResource S.TipLanguage}"
                      AutomationProperties.Name="{DynamicResource S.TipLanguage}">
                <ComboBoxItem Content="简体中文" Tag="zh" />
                <ComboBoxItem Content="English" Tag="en" />
            </ComboBox>
        </Grid>

        <Border x:Name="ErrorBanner" Grid.Row="2" Visibility="Collapsed" Margin="0,0,0,8" Padding="12,8"
                CornerRadius="6" Background="#33E5484D" BorderBrush="#E5484D" BorderThickness="1">
            <TextBlock x:Name="ErrorText" TextWrapping="Wrap" />
        </Border>

        <!-- GitHub 上有新版本时显示 -->
        <Border x:Name="UpdateBanner" Grid.Row="3" Visibility="Collapsed" Margin="0,0,0,8" Padding="12,8"
                CornerRadius="6" Background="#332EA043" BorderBrush="{StaticResource GoBrush}" BorderThickness="1"
                AutomationProperties.AutomationId="UpdateBanner">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="UpdateText" VerticalAlignment="Center" TextWrapping="Wrap" FontWeight="SemiBold" />
                <Button Grid.Column="1" Height="30" Padding="10,0" Margin="12,0,0,0" Content="{DynamicResource S.UpdateDownload}" Click="UpdateDownload_Click"
                        AutomationProperties.AutomationId="UpdateDownload" />
                <Button Grid.Column="2" Height="30" Padding="10,0" Margin="6,0,0,0" Content="{DynamicResource S.UpdateSkip}" Click="UpdateSkip_Click" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <ItemsControl x:Name="SlotList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,5" Padding="12,5" CornerRadius="6" BorderThickness="1"
                                    Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                                    BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Enabled}" Value="False">
                                                <Setter Property="Opacity" Value="0.55" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <!-- 单独开关这个序号 -->
                                    <CheckBox Grid.Column="0" Margin="0,0,8,0" VerticalAlignment="Center" MinWidth="0" Padding="0"
                                              IsChecked="{Binding Enabled, Mode=OneWay}" IsEnabled="{Binding CanToggle}"
                                              Checked="SlotEnable_Toggled" Unchecked="SlotEnable_Toggled" ToolTip="{DynamicResource S.TipSlotEnable}"
                                              AutomationProperties.AutomationId="SlotEnable" />

                                    <!-- 序号: 有实体手柄接入时变绿 -->
                                    <Border Grid.Column="1" Width="30" Height="30" CornerRadius="15" VerticalAlignment="Center">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="{StaticResource IdleBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Connected}" Value="True">
                                                        <Setter Property="Background" Value="{StaticResource GoBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Number}" FontSize="15" FontWeight="Bold"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Connected}" Value="True">
                                                            <Setter Property="Foreground" Value="White" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>

                                    <StackPanel Grid.Column="2" Margin="12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding VirtualName}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding PadText}" Opacity="0.7" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!-- 震动指示: 游戏让这个手柄震动时亮起 -->
                                    <TextBlock Grid.Column="3" Text="&#xE877;" FontFamily="Segoe Fluent Icons, Segoe MDL2 Assets" FontSize="15"
                                               Margin="0,0,10,0" VerticalAlignment="Center" ToolTip="{DynamicResource S.TipRumbleIndicator}">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Opacity" Value="0.2" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding Rumbling}" Value="True">
                                                        <Setter Property="Opacity" Value="1" />
                                                        <Setter Property="Foreground" Value="{StaticResource GoBrush}" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>

                                    <!-- 输入指示灯: 对应的实体手柄有按键/摇杆动作时亮起 -->
                                    <Ellipse Grid.Column="4" Style="{StaticResource ActivityDot}" Margin="0,0,10,0" ToolTip="{DynamicResource S.TipActivity}" />

                                    <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                                        <Button Style="{StaticResource IconButton}" Margin="0"
                                                AutomationProperties.Name="{DynamicResource S.Pin}" AutomationProperties.AutomationId="Pin"
                                                IsEnabled="{Binding HasContent}" Click="Pin_Click" ToolTip="{DynamicResource S.TipPin}">
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Glyph}">
                                                        <Setter Property="Text" Value="&#xE718;" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                                                <Setter Property="Text" Value="&#xE841;" />
                                                                <Setter Property="Foreground" Value="{StaticResource GoBrush}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}"
                                                AutomationProperties.Name="{DynamicResource S.MoveUp}" AutomationProperties.AutomationId="MoveUp"
                                                IsEnabled="{Binding CanMoveUp}" Click="MoveUp_Click" ToolTip="{DynamicResource S.TipMoveUp}">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE70E;" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}"
                                                AutomationProperties.Name="{DynamicResource S.MoveDown}" AutomationProperties.AutomationId="MoveDown"
                                                IsEnabled="{Binding CanMoveDown}" Click="MoveDown_Click" ToolTip="{DynamicResource S.TipMoveDown}">
                                            <TextBlock Style="{StaticResource Glyph}" Text="&#xE70D;" />
                                        </Button>
                                        <Button Margin="4,0,0,0" Height="30" Padding="10,0" Content="{DynamicResource S.Rumble}"
                                                AutomationProperties.AutomationId="Rumble"
                                                IsEnabled="{Binding CanRumble}" Click="Identify_Click" ToolTip="{DynamicResource S.TipRumble}" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 待分配: 接入了但 8 个序号都已占满的手柄 -->
                <StackPanel x:Name="WaitingPanel" Visibility="Collapsed" Margin="0,4,0,0">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="{DynamicResource S.WaitingHeader}" />
                    <ItemsControl x:Name="WaitingList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,5" Padding="12,5" CornerRadius="6" BorderThickness="1"
                                        Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" BorderBrush="#E0A100">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="{Binding Text}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                        <Button Grid.Column="1" Height="30" Padding="10,0" Content="{DynamicResource S.AssignTo}"
                                                Click="Assign_Click" ToolTip="{DynamicResource S.TipAssign}"
                                                Tag="{Binding Id}" AutomationProperties.AutomationId="Assign" />
                                        <Button Grid.Column="2" Margin="4,0,0,0" Height="30" Padding="10,0" Content="{DynamicResource S.Rumble}"
                                                Tag="{Binding Id}" Click="IdentifyWaiting_Click" ToolTip="{DynamicResource S.TipRumble}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- 放不下时插件状态自动折到下一行, 不被截断 -->
        <WrapPanel Grid.Row="5" Margin="0,8,0,8">
            <Button Content="{DynamicResource S.OpenSettings}" Height="30" Padding="10,0" Margin="0,0,6,4" Click="OpenSettings_Click"
                    AutomationProperties.AutomationId="OpenSettings" ToolTip="{DynamicResource S.TipOpenSettings}" />
            <Button Content="{DynamicResource S.OneClickApply}" Height="30" Padding="10,0" Margin="0,0,6,4" Click="OneClickApply_Click"
                    AutomationProperties.AutomationId="OneClickApply" ToolTip="{DynamicResource S.TipOneClickApply}" />
            <Button Content="{DynamicResource S.BridgeInstall}" Height="30" Padding="10,0" Margin="0,0,6,4" Click="InstallBridge_Click"
                    AutomationProperties.AutomationId="InstallBridge" ToolTip="{DynamicResource S.TipBridge}" />
            <Border Height="30" Margin="6,0,0,4">
                <TextBlock x:Name="BridgeStatus" Opacity="0.65" VerticalAlignment="Center" ToolTip="{DynamicResource S.TipBridge}" />
            </Border>
        </WrapPanel>

        <TextBox x:Name="LogBox" Grid.Row="6" Height="64" IsReadOnly="True" TextWrapping="NoWrap"
                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" FontSize="12" />
    </Grid>
</Window>
